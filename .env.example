# ----------------------
# Database connections
# ----------------------

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1                # PostgreSQL server host
POSTGRES_USER=postgres                 # PostgreSQL user
POSTGRES_DB=postgres                   # PostgreSQL database name
DB_PASSWORD=Admin@1234                 # Local development only; change outside Development
POSTGRES_SHM_SIZE=256MB                # PostgreSQL shared memory size (optional)
PGADMIN_DEFAULT_PASSWORD=vietwash-local-admin
PGADMIN_DEFAULT_EMAIL=admin@vietwash.local

# Redis Configuration
REDIS_PASSWORD=Admin@123               # Matches local Development settings

# Local observability
SEQ_FIRSTRUN_ADMINPASSWORD=vietwash-local-seq

# Memory Limit for Docker containers (in bytes)
MEM_LIMIT=1073741824                         # Example: 1GB (1073741824 bytes)

# ----------------------
# Docker Compose (Optional)
# ----------------------

# COMPOSE_PROJECT_NAME=myproject             # Project namespace (optional, defaults to folder name)

# ----------------------
# MinIO Configuration
# ----------------------

MINIO_ROOT_USER=vietwash-local-minio
MINIO_ROOT_PASSWORD=vietwash-local-minio-change-me
MINIO_ACCESS_KEY=vietwash-local-minio
MINIO_SECRET_KEY=vietwash-local-minio-change-me
