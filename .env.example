# These are local placeholders, not secure defaults. Change them in your untracked .env file.

# ----------------------
# Database connections
# ----------------------

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1                # PostgreSQL server host
POSTGRES_USER=postgres                 # PostgreSQL user
POSTGRES_DB=postgres                   # PostgreSQL database name
DB_PASSWORD=change-me-local            # Local placeholder; must be changed outside Development
POSTGRES_SHM_SIZE=256MB                # PostgreSQL shared memory size (optional)
PGADMIN_DEFAULT_PASSWORD=change-me-local
PGADMIN_DEFAULT_EMAIL=admin@vietwash.local

# Redis Configuration
REDIS_PASSWORD=change-me-local          # Matches local Development settings

# Local observability
SEQ_FIRSTRUN_ADMINPASSWORD=change-me-local

# Memory Limit for Docker containers (in bytes)
MEM_LIMIT=1073741824                         # Example: 1GB (1073741824 bytes)

# ----------------------
# Docker Compose (Optional)
# ----------------------

# COMPOSE_PROJECT_NAME=myproject             # Project namespace (optional, defaults to folder name)

# Non-secret staging image selection. Use sha-<12-character-commit> for rollback.
GHCR_OWNER=johnvo402
IMAGE_TAG=dev

# ----------------------
# PayOS (Ecommerce API)
# ----------------------
# Keep disabled for local development unless all six values below are configured.
PayOsSetting__IsEnabled=false
PayOsSetting__ClientId=
PayOsSetting__ApiKey=
PayOsSetting__ChecksumKey=
PayOsSetting__ReturnUrl=https://app.example.com/payment/payos-return
PayOsSetting__CancelUrl=https://app.example.com/payment/payos-return
PayOsSetting__WebhookUrl=https://api.example.com/Webhook/api/CompletedOrder

# ----------------------
# MinIO Configuration
# ----------------------

MINIO_ROOT_USER=vietwash-local-minio
MINIO_ROOT_PASSWORD=change-me-local
MINIO_ACCESS_KEY=vietwash-local-minio
MINIO_SECRET_KEY=change-me-local
