# ----------------------
# Database connections
# ----------------------

# PostgreSQL Configuration
POSTGRES_HOST=127.0.0.1                # PostgreSQL server host
POSTGRES_USER=postgres                 # PostgreSQL user
POSTGRES_DB=postgres                   # PostgreSQL database name
DB_PASSWORD=your_postgres_password     # PostgreSQL password
POSTGRES_SHM_SIZE=256MB                # PostgreSQL shared memory size (optional)

# Redis Configuration
REDIS_PASSWORD=your_redis_password     # Redis password

# ----------------------
# API Keys
# ----------------------
ASPIRE_API_KEY=your_aspire_api_key     # API Key for Aspire (replace with actual key)

# ----------------------
# Elasticsearch & Kibana
# ----------------------

# Elasticsearch & Kibana Passwords
ELASTIC_PASSWORD=your_elastic_password       # Password for 'elastic' user (min 6 characters)
KIBANA_PASSWORD=your_kibana_password         # Password for 'kibana_system' user (min 6 characters)

# Elasticsearch Stack Version
STACK_VERSION=8.17.1                         # Version of Elastic Stack to use

# Elasticsearch Cluster Name
CLUSTER_NAME=docker-cluster                  # Name of the Elasticsearch cluster

# License type (basic/trial)
LICENSE=basic                                # Set to 'basic' or 'trial' for 30-day trial

# Elasticsearch Port
ES_PORT=9200                                 # Port for Elasticsearch HTTP API (default 9200)
# ES_PORT=127.0.0.1:9200                     # Alternative binding to localhost (uncomment to use)

# Kibana Port
KIBANA_PORT=5601                             # Port for Kibana (default 5601)
# KIBANA_PORT=80                             # Alternative port (uncomment to use)

# ----------------------
# System Resources
# ----------------------

# Memory Limit for Docker containers (in bytes)
MEM_LIMIT=1073741824                         # Example: 1GB (1073741824 bytes)

# ----------------------
# Docker Compose (Optional)
# ----------------------

# COMPOSE_PROJECT_NAME=myproject             # Project namespace (optional, defaults to folder name)

# ----------------------
# MinIO Configuration
# ----------------------

MINIO_ROOT_USER=your_minio_root_user         # MinIO root username
MINIO_ROOT_PASSWORD=your_minio_root_password # MinIO root password
MINIO_ACCESS_KEY=your_minio_access_key       # MinIO access key
MINIO_SECRET_KEY=your_minio_secret_key       # MinIO secret key
