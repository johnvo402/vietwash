# Browser-visible application configuration. Do not place secrets in NEXT_PUBLIC_* values.
NEXT_PUBLIC_API_URL=http://localhost:5000
# Staging Docker builds leave NEXT_PUBLIC_API_URL empty: HTTP and SignalR use the
# browser's origin through Nginx. Never put a Docker hostname in NEXT_PUBLIC_*.
NEXT_PUBLIC_MEDIA_URL=http://127.0.0.1:9000

# Public client identification only; JWT authorization remains the security boundary.
NEXT_PUBLIC_CLIENT_ID=admin-laundry
NEXT_PUBLIC_PLATFORM=admin-web

# Optional server URL written into the merged OpenAPI document during generation.
OPENAPI_SERVER_URL=http://localhost:5000

# Optional comma- or space-separated trusted origins added to connect-src.
# Use explicit production origins (for example, https://api.example.com); wildcards are not accepted.
CSP_CONNECT_SRC=
