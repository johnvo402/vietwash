    "node-rsa": "^1.1.1",
    "nuqs": "^2.4.1",
    "qs": "^6.14.0",
    "react": "^18.2.0",
    "react-day-picker": "^8.10.1",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.54.2",
    "react-intersection-observer": "^9.16.0",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.1",
    "resend": "^3.2.0",
    "sass": "^1.83.4",
    "sharp": "^0.32.6",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "uploadthing": "^6.10.0",
    "uuid": "^10.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^15.3.4",
