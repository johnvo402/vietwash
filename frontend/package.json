    "@types/elliptic": "^6.4.18",
    "@types/lodash": "^4.17.19",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^20",
    "@types/node-rsa": "^1.1.4",
    "@types/qs": "^6.9.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "^14.2.2",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss": "^8",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.4.5"
  },
  "lint-staged": {
    "**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "**/*.{js,jsx,css,md}": "prettier --write"
  }
}
