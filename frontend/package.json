{
  "name": "micro-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run generate && next build",
    "build:test": "next build",
    "start": "next start",
    "lint": "next lint",
    "merged-api": "ts-node generate-clients.ts",
    "generate": "rimraf src/api/generated && openapi-generator-cli generate -i ./openapi.json -g typescript-axios -o src/api/generated",
    "generate-types": "npm run merged-api && npm run generate",
    "test:record": "concurrently -k -n \"NEXT,GEN\" -c \"blue,green\" \"next dev\" \"npx wait-on http://localhost:3000 && npx playwright codegen http://localhost:3000\"",
    "test:run": "playwright test --project=auth --project=feature-tests",
    "test:headed": "playwright test --project=auth --project=feature-tests --headed",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "@microsoft/signalr": "^7.0.5",
    "@openapitools/openapi-generator-cli": "^2.15.3",
    "@popperjs/core": "^2.11.8",
    "@radix-ui/react-alert-dialog": "^1.1.6",
    "@radix-ui/react-aspect-ratio": "^1.0.3",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-checkbox": "^1.1.2",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.0.3",
    "@radix-ui/react-radio-group": "^1.2.3",
    "@radix-ui/react-scroll-area": "^1.2.1",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.3",
    "@radix-ui/react-toast": "^1.2.2",
    "@radix-ui/react-toggle": "^1.1.9",
    "@radix-ui/react-toggle-group": "^1.1.10",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@react-email/components": "^0.3.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tanstack/react-query": "^5.32.0",
    "@tanstack/react-table": "^8.20.5",
    "@tanstack/react-virtual": "^3.13.4",
    "@tiptap/extension-bold": "^3.0.7",
    "@tiptap/extension-italic": "^3.0.7",
    "@tiptap/extension-underline": "^3.0.7",
    "@tiptap/react": "^3.0.7",
    "@tiptap/starter-kit": "^3.0.7",
    "@types/uuid": "^10.0.0",
    "@uploadthing/react": "^6.5.0",
    "@vercel/speed-insights": "^1.0.14",
    "@zxing/browser": "^0.1.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "date-fns": "^3.6.0",
    "elliptic": "^6.6.1",
    "exceljs": "^4.4.0",
    "framer-motion": "^11.1.7",
    "html2canvas": "^1.4.1",
    "immer": "^10.1.1",
