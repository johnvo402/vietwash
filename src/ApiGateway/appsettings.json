{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "image": {
        "ClusterId": "image-cluster",
        "Match": {
          "Path": "/image/{**catch-all}"
        },
        "Transforms": [
          {
            "PathRemovePrefix": "/image"
          }
        ]
      },
      "auth": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth/{**catch-all}"
        }
      },
      "ecommerce": {
        "ClusterId": "product-cluster",
        "RateLimiterPolicy": "customPolicy",
        "Match": {
          "Path": "/ecommerce/{**catch-all}"
        }
      },
      "project": {
        "ClusterId": "product-cluster",
        "RateLimiterPolicy": "customPolicy",
        "Match": {
          "Path": "/project/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "image-cluster": {
        "Destinations": {
          "image": {
            "Address": "http://nginx-s3:9000/"
          }
        }
      },
      "auth-cluster": {
        "Destinations": {
          "auth": {
            "Address": "http://auth:8080/"
          }
        }
      },
      "ecommerce-cluster": {
        "Destinations": {
          "ecommerce": {
            "Address": "http://ecommerce:8080/"
          }
        }
      },
      "project-cluster": {
        "Destinations": {
          "project": {
            "Address": "http://project:8080/"
          }
        }
      }
    }
  }
}