@model Application.Feature.Common.Projections.Receipts.ReceiptModel;


<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Biên Lai 3 Liên</title>
    <style>
        body {
            font-family: "Times New Roman", Times, serif;
            margin: 0;
            padding: 0;
            display: flex;
            flex-direction: column;
            align-items: center;
            background-color: #ffffff;
        }

        .receipt {
            width: 210mm;
            height: 297mm;
            border: 1px solid #000;
            padding: 10mm;
            box-sizing: border-box;
            page-break-inside: avoid;
        }

        .header {
            text-align: center;
            margin-bottom: 10mm;
        }

        .header h1 {
            font-size: 18px;
            margin: 0;
            color: #000;
        }

        .header p {
            font-size: 12px;
            margin: 2mm 0;
        }

        .header .receipt-title {
            font-size: 16px;
            font-weight: bold;
            margin: 2mm 0;
        }

        .logo {
            width: 50mm;
            height: 25mm;
            margin-bottom: 5mm;
        }

        .info {
            font-size: 12px;
            margin-bottom: 5mm;
            text-align: left;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 0;
            font-size: 12px;
        }

        table,
        th,
        td {
            border: 1px solid #000;
        }

        th {
            background-color: #f0f0f0;
            padding: 5mm;
            text-align: center;
        }

        td {
            padding: 4mm;
            text-align: center;
        }

        .total-row {
            font-weight: bold;
            text-align: right;
            padding: 5mm;
        }

        .signatures {
            display: flex;
            justify-content: space-between;
            margin-top: 20mm;
            font-size: 12px;
        }

        .signatures p {
            margin: 0;
            text-align: center;
        }

        .stamp {
            width: 50mm;
            height: 25mm;
        }

        .amount-in-words {
            font-size: 12px;
            margin-top: 5mm;
            text-align: left;
        }

        .copy:nth-child(1) .receipt {
            background-color: #e6f3ff;
        }

        .copy:nth-child(2) .receipt {
            background-color: #ffe6e6;
        }

        .copy:nth-child(3) .receipt {
            background-color: #e6ffe6;
        }
    </style>
</head>

<body>
    <!-- Copy 1 -->
    <div class="copy">
        <div class="receipt">
            <div class="header">
                <div class="logo">
                    <img src="@Model.OrgInfo?.Logo" alt="Logo" width="100%" height="100%">
                </div>
                <h1>CỬA HÀNG GIẶT ỦI VIETWASH</h1>
                <p>Địa chỉ: Nguyễn Văn Cừ, An Khánh, Ninh Kiều, Cần Thơ</p>
                <p>Điện thoại: 038 339 5692</p>
                <p class="receipt-title">Biên Lai</p>
            </div>
            <div class="info">
                <p>Khách hàng: @Model.Customer.DisplayName</p>
                <p>SĐT: @Model.Customer.PhoneNumber</p>
                <p>Ngày: @Model.OrderDate.ToString("dd/MM/yyyy")</p>
            </div>
            <table>
                <tr>
                    <th>STT</th>
                    <th>Dịch vụ</th>
                    <th>DVT</th>
                    <th>Số lượng</th>
                    <th>Đơn Giá</th>
                    <th>Thành Tiền</th>
                </tr>
                @{
                    int index = 0;
                    foreach (var item in Model.OrderItems)
                    {
                        index++;
                        <tr>
                            <td>@index</td>
                            <td>@item.ServiceName</td>
                            <td>@item.UnitRelationName</td>
                            <td>@item.Quantity</td>
                            <td>@item.UnitPrice</td>
                            <td>@item.TotalPriceItem</td>
                        </tr>
                    }
                    while (index < 4)
                    {
                        index++;
                        <tr>
                            <td>@index</td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    }
                    <tr class="total-row">
                        <td colspan="5">Thành Tiền</td>
                        <td>@Model.Total</td>
                    </tr>
                }
            </table>
            <div class="amount-in-words">
                <p>Thành Tiền Bằng Chữ: @Model.TotalInWords</p>
            </div>
            <div class="signatures">
                <p>Chữ ký khách hàng</p>
                <p>Chữ ký nhân viên</p>
                <p><img src="@Model.OrgInfo?.Stamp" alt="Con dấu" class="stamp"></p>
            </div>
            <p><strong>Phiếu gốc - Lưu khách hàng</strong></p>
        </div>
    </div>

