@{
    var logoBase64 =
    "data:image/svg+xml;base64,";
    var stampBase64 =
    "data:image/svg+xml;base64,";
}

<!-- Copy 1 -->
<div class="copy">
    <div class="receipt">
        <div class="header">
            <div class="logo">
                <img src="@logoBase64" alt="Logo" width="100%" height="100%">
            </div>
            <h1>CỬA HÀNG GIẶT ỦI VIETWASH</h1>
            <p>Địa chỉ: Nguyễn Văn Cừ, An Khánh, Ninh Kiều, Cần Thơ</p>
            <p>Điện thoại: 038 339 5692</p>
        </div>
        <div class="info">
            <p>Khách hàng: @Model.Customer.DisplayName</p>
            <p>SĐT: @Model.Customer.PhoneNumber</p>
            <p>Ngày: @Model.OrderDate.ToString("dd/MM/yyyy")</p>
        </div>
        <table>
            <tr>
                <th>STT</th>
                <th>Dịch vụ</th>
                <th>DVT</th>
                <th>Số lượng</th>
                <th>Đơn Giá</th>
                <th>Thành Tiền</th>
            </tr>
            @{
                int index = 0;
                foreach (var item in Model.OrderItems)
                {
                    index++;
                    <tr>
                        <td>@index</td>
                        <td>@item.ServiceName</td>
                        <td>@item.UnitRelationName</td>
                        <td>@item.Quantity</td>
                        <td>@item.UnitPrice</td>
                        <td>@(item.Quantity* item.UnitPrice)</td>
                    </tr>
                }
                while (index < 5)
                {
                    index++;
                    <tr>
                        <td>@index</td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                    </tr>
                }
            }
        </table>
        <div class="total-row">
            <p>TỔNG CỘNG: @Model.Total</p>
        </div>
        <div class="signatures">
            <p>Chữ ký khách hàng</p>
            <p>Chữ ký nhân viên</p>
            <p><img src="@stampBase64" alt="Con dấu" class="stamp"></p>
        </div>
        <p><strong>Phiếu gốc - Lưu khách hàng</strong></p>
    </div>
</div>

